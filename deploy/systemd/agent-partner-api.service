[Unit]
Description=Agent Partner FastAPI service
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=agent-partner
Group=agent-partner
WorkingDirectory=/srv/agent_partner/app
EnvironmentFile=/etc/agent-partner/agent-partner.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/agent_partner/app/.venv/bin/python -m uvicorn backend.eval_agent.api.main:app --host 127.0.0.1 --port 8070 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/agent_partner/runs
UMask=0027

[Install]
WantedBy=multi-user.target
